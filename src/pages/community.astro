---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Community — TOGN"
  description="TOGN community events: bike rides, trail work parties, and more in Tualatin."
>
  <div class="page-header">
    <div class="container">
      <h1>Community</h1>
      <p>Rides, work parties, and good company in Tualatin.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">

      <div class="event-card">
        <div class="event-label">Bikes &amp; Brunch</div>
        <h2>Community Bike Rides</h2>
        <p>
          We will be organizing community bike rides starting at <strong>Natchez Ct</strong> and
          ending at <strong>Artur Cafe</strong> in the Summer and Fall of 2026. Rides are open
          to all ages and abilities — a great way to explore Tualatin's neighborhoods and trails
          alongside friendly neighbors.
        </p>
        <p>Sign up to our announcement list for schedule details as they're confirmed.</p>
        <div class="btn-group">
          <a href="mailto:announce+subscribe@togn.org" class="btn">Join the Announcement List</a>
        </div>
      </div>

      <div class="event-card">
        <div class="event-label">Trail Stewardship</div>
        <h2>Greenway Trail Work Parties</h2>
        <p>
          We will be organizing community work parties at the <strong>Natchez Ct entrance</strong> to
          the <a href="https://www.tualatinoregon.gov/recreation/tualatin-river-greenway-trail" target="_blank" rel="noopener">Tualatin River Greenway Trail</a>
          to beat back invasive plants like blackberries and ivy.
        </p>
        <p>
          No experience needed — just gloves, sturdy shoes, and a willingness to dig in. Tools
          and guidance provided. Sign up to our announcement list to be notified of upcoming dates.
        </p>
        <div class="btn-group">
          <a href="mailto:announce+subscribe@togn.org" class="btn">Join the Announcement List</a>
          <a href="/trails" class="btn btn-outline">Learn About Trail Stewardship</a>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--green-dark) 0%, var(--sky) 100%);
    color: var(--white);
    padding: 3.5rem 1.5rem;
  }

  .page-header h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.4rem; }
  .page-header p { opacity: 0.85; font-size: 1.05rem; }

  .container { max-width: 800px; margin: 0 auto; }

  .section { padding: 3rem 1.5rem 5rem; }

  .event-card {
    background: var(--white);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    border-top: 4px solid var(--green-light);
    margin-bottom: 1.75rem;
  }

  .event-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-mid);
    background: var(--green-pale);
    padding: 0.2rem 0.7rem;
    border-radius: 99px;
    margin-bottom: 0.75rem;
  }

  .event-card h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green-dark);
    margin-bottom: 0.75rem;
  }

  .event-card p {
    font-size: 1rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .event-card p:last-of-type { margin-bottom: 1.25rem; }

  .event-card strong { color: var(--text); }

  .event-card a:not(.btn) { color: var(--green-mid); }
  .event-card a:not(.btn):hover { text-decoration: underline; }

  .btn-group { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .btn {
    display: inline-block;
    background: var(--green-light);
    color: var(--green-dark);
    font-weight: 700;
    padding: 0.65rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: background 0.2s, transform 0.1s;
  }

  .btn:hover { background: #74d6a0; text-decoration: none; transform: translateY(-1px); }

  .btn-outline {
    background: transparent;
    color: var(--green-mid);
    border: 2px solid var(--green-mid);
  }

  .btn-outline:hover { background: var(--green-pale); text-decoration: none; }
</style>
