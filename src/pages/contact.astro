---
import Layout from '../layouts/Layout.astro';
import MailingListSignup from '../components/MailingListSignup.astro';
---

<Layout
  title="Contact — Tualatin Oregon Growth Network"
  description="Get in touch with the Tualatin Oregon Growth Network."
>
  <div class="page-header">
    <div class="container">
      <h1>Contact</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <p class="lead">Have a question, idea, or want to get involved? We'd love to hear from you.</p>

      <div class="contact-card">
        <div class="contact-icon">✉️</div>
        <div>
          <h2>Email Us</h2>
          <p>Reach Brandon directly at <a href="mailto:brandon@togn.org">brandon@togn.org</a>.</p>
        </div>
      </div>

      <MailingListSignup variant="card" />
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--green-dark);
    color: var(--white);
    padding: 3rem 1.5rem;
  }

  .page-header h1 { font-size: 2.2rem; font-weight: 800; }

  .container { max-width: 800px; margin: 0 auto; }

  .section { padding: 3rem 1.5rem 5rem; }

  .lead {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .contact-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: var(--white);
    border-radius: 10px;
    padding: 1.75rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    border-left: 4px solid var(--green-light);
    margin-bottom: 1.25rem;
  }

  .contact-icon { font-size: 1.75rem; flex-shrink: 0; }

  .contact-card h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--green-dark);
    margin-bottom: 0.4rem;
  }

  .contact-card p { font-size: 0.95rem; color: var(--text-light); line-height: 1.6; }

  .contact-card a { color: var(--green-mid); }
  .contact-card a:hover { text-decoration: underline; }

</style>
