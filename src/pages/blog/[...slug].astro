---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${post.data.title} — Tualatin Oregon Growth Network`} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <div class="container">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
        <h1>{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
      </div>
    </header>

    {post.data.videoId && (
      <div class="video-wrapper">
        <div class="container">
          <div class="video-embed">
            <iframe
              src={`https://www.youtube.com/embed/${post.data.videoId}`}
              title="YouTube video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    )}

    <div class="post-body section">
      <div class="container prose">
        <Content />
        <div class="back-link">
          <a href="/blog">← Back to Blog</a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .post-header {
    background: var(--green-dark);
    color: var(--white);
    padding: 3rem 1.5rem 2.5rem;
  }

  .container { max-width: 800px; margin: 0 auto; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  time { font-size: 0.85rem; opacity: 0.75; }

  .tag {
    font-size: 0.75rem;
    background: rgba(255,255,255,0.15);
    color: var(--white);
    padding: 0.15rem 0.65rem;
    border-radius: 99px;
    font-weight: 600;
  }

  .post-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .post-desc { opacity: 0.85; font-size: 1.05rem; max-width: 640px; }

  /* Video */
  .video-wrapper { background: #111; padding: 1.5rem 1.5rem; }

  .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
  }

  .video-embed iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: none;
  }

  /* Prose body */
  .section { padding: 2.5rem 1.5rem 4rem; }

  .prose { font-size: 1.05rem; line-height: 1.75; color: var(--text); }

  .prose :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green-dark);
    margin: 2.25rem 0 0.75rem;
  }

  .prose :global(p) { margin-bottom: 1.1rem; }

  .prose :global(blockquote) {
    border-left: 4px solid var(--green-light);
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--green-pale);
    border-radius: 0 6px 6px 0;
    font-style: italic;
    color: var(--text-light);
  }

  .prose :global(blockquote p) { margin-bottom: 0.4rem; }

  .prose :global(a) { color: var(--green-mid); text-decoration: underline; }
  .prose :global(a:hover) { color: var(--green-dark); }

  .prose :global(strong) { color: var(--green-dark); font-weight: 700; }

  .back-link { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #e0e8e2; }
  .back-link a { font-weight: 600; color: var(--green-mid); }
  .back-link a:hover { text-decoration: underline; }
</style>
