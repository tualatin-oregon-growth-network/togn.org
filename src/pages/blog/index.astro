---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Blog — Tualatin Oregon Growth Network" description="News and updates from the Tualatin Oregon Growth Network.">
  <div class="page-header">
    <div class="container">
      <h1>Blog</h1>
      <p>News, updates, and perspectives on Tualatin's sustainable growth.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {posts.length === 0 && <p>No posts yet — check back soon.</p>}
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-card">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
            <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
            <p class="post-desc">{post.data.description}</p>
            <a href={`/blog/${post.slug}`} class="read-more">Read more →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--green-dark);
    color: var(--white);
    padding: 3rem 1.5rem;
  }

  .page-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-header p { opacity: 0.85; font-size: 1.05rem; }

  .container { max-width: 800px; margin: 0 auto; }

  .section { padding: 3rem 1.5rem; }

  .post-list { list-style: none; display: flex; flex-direction: column; gap: 2rem; }

  .post-card {
    background: var(--white);
    border-radius: 10px;
    padding: 1.75rem 2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    border-left: 4px solid var(--green-light);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  time { font-size: 0.85rem; color: var(--text-light); }

  .tag {
    font-size: 0.75rem;
    background: var(--green-pale);
    color: var(--green-dark);
    padding: 0.15rem 0.6rem;
    border-radius: 99px;
    font-weight: 600;
  }

  .post-card h2 { font-size: 1.3rem; margin-bottom: 0.5rem; }
  .post-card h2 a { color: var(--green-dark); }
  .post-card h2 a:hover { color: var(--green-mid); text-decoration: underline; }

  .post-desc { color: var(--text-light); font-size: 0.95rem; margin-bottom: 1rem; }

  .read-more { font-size: 0.9rem; font-weight: 600; color: var(--green-mid); }
  .read-more:hover { text-decoration: underline; }
</style>
